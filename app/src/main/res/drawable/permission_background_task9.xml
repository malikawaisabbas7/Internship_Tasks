<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main sky gradient -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#6FB1E8"
                android:centerColor="#9BC9EA"
                android:endColor="#E8DFF5" />

        </shape>
    </item>

    <!-- Soft light glow -->
    <item
        android:top="120dp"
        android:left="40dp"
        android:right="40dp"
        android:bottom="300dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#55FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

</layer-list>