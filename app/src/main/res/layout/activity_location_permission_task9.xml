<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/permission_background_task9">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@drawable/permission_card_task9">


<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="☀️"-->
<!--            android:textSize="58sp"-->
<!--            android:layout_marginBottom="12dp" />-->


        <TextView
            android:id="@+id/tvPermissionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to Weather App"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#17324D"
            android:gravity="center"
            android:layout_marginBottom="16dp" />


        <TextView
            android:id="@+id/tvPermissionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow location access to get the current weather and local news for your location."
            android:textSize="17sp"
            android:textColor="#536A7D"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="26dp" />


        <Button
            android:id="@+id/btnAllowLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow Location"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:minHeight="52dp"
            android:backgroundTint="#2F80ED" />

    </LinearLayout>

</LinearLayout>